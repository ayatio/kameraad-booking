DATABASE_URL=postgresql://kameraad:kameraad_dev@localhost:5432/kameraad

# Auth.js (NextAuth v5). Set a strong random value in every real environment
# (e.g. `openssl rand -base64 32`). If unset, src/auth.ts falls back to an
# INSECURE dev-only constant — never rely on that fallback outside local dev.
AUTH_SECRET=
# NEXTAUTH_SECRET is read as a fallback for AUTH_SECRET (either works).
# NEXTAUTH_SECRET=

# Base URL used to build admin set-password / customer links (no trailing slash).
APP_BASE_URL=http://localhost:3000

# ─── SEO (FR-101) ────────────────────────────────────────────────────────────
# Public origin used for canonical URLs, hreflang alternates, sitemap.xml,
# robots.txt and JSON-LD (no trailing slash). Set to the production domain at
# deploy; defaults to localhost for dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search-engine indexability switch. UNSET or anything other than "true" =
# NOINDEX (staging/preview/local posture): robots.txt disallows all and every
# page emits robots: noindex,nofollow. Set to exactly "true" ONLY on the real
# production deploy to allow crawling. Leave UNSET everywhere else.
NEXT_PUBLIC_ALLOW_INDEXING=
