{
  "name": "kameraad-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lhci": "NEXT_PUBLIC_ALLOW_INDEXING=true NEXT_PUBLIC_SITE_URL=http://localhost:3911 next build && lhci autorun",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "bcryptjs": "^2.4.3",
    "next": "14",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.49.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "14",
    "eslint-config-prettier": "^9",
    "playwright": "^1.49.1",
    "postcss": "^8",
    "prettier": "^3",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^2"
  }
}
